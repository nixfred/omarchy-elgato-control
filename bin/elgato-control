"""Small hidapi-based Stream Deck daemon for Omarchy."""
import argparse, ctypes, hashlib, ipaddress, json, os, pathlib, re, shutil, signal, socket, stat, subprocess, sys, tempfile, time, urllib.error, urllib.request

VID = 0x0FD9
PLUS, PEDAL = 0x0084, 0x0086
DEVICE_SPECS = {
    PLUS: {"kind": "streamdeck", "capabilities": ["keys", "dials", "dialPress", "lcd", "touch", "brightness"]},
    PEDAL: {"kind": "pedal", "capabilities": ["pedals"]},
}
ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "bin"))
import cyber_icons
